<div class='chat'>
    {{#unless messages}}
        <div class='chat__placeholder'>Выберите чат чтобы отправить сообщение</div>
    {{/unless}}
    {{#if messages}}
        {{{ChatProfile}}}
        <div class='messages'>
            {{{messages}}}
        </div>
        {{{ChatFooter}}}
    {{/if}}
    {{{Navbar}}}
</div>